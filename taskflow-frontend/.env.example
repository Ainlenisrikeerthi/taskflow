# ─────────────────────────────────────────────────────────
# TaskFlow Frontend – Environment Variables
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────

# Backend base URL (no trailing slash, no /api suffix)
# Default: http://localhost:8080/api (used if not set)
VITE_API_BASE_URL=http://localhost:8080

# Google OAuth 2.0 Client ID (Web application)
# Required for Google Sign-In / Register.
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID of type "Web application"
# 3. Add http://localhost:5173 to Authorized JavaScript origins
# Leave blank to disable Google Sign-In (standard email/password still works).
VITE_GOOGLE_CLIENT_ID=