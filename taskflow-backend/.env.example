# ==========================================
# TaskFlow Backend Environment Variables
# ==========================================

# Server
PORT=8080

# Supabase / PostgreSQL Database Connection
DB_URL=postgresql:
DB_USERNAME=
DB_PASSWORD=

# JPA Settings (update or validate)
JPA_DDL_AUTO=update
SHOW_SQL=true

# JWT Security
JWT_SECRET=
JWT_EXPIRATION=86400000

# SMTP Email Configuration (for assignment removal notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Allowed Frontend Origin (for CORS)
FRONTEND_URL=
